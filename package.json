{
  "name": "recipes",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:data": "node build.mjs",
    "build:js": "esbuild client.js --bundle --format=iife --outfile=site/recipe-app.js --minify",
    "build:css": "cp node_modules/@gram-lang/renderer/gram.css node_modules/@gram-lang/renderer/gantt.css site/css/",
    "build": "npm run build:data && npm run build:js && cd site && quarto render",
    "check": "gram check \"recipes/**/*.gram\"",
    "test": "node snippet.mjs && node import-parser.mjs",
    "serve": "python3 -m http.server 8801 -d site/_site"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@gram-lang/analyzer": "^1.2.0",
    "@gram-lang/cli": "^1.2.0",
    "@gram-lang/kitchen": "^1.2.0",
    "@gram-lang/parser": "^1.2.0",
    "@gram-lang/renderer": "^1.2.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
